		{
			"type": "observation",
			"id": "s7",
			"t": 103,
			"kind": "exchange.adopted",
			"actor": "user",
			"text": "A社への発注書を作って。型番と数量は仕様書のとおりで。"
		},
		{
			"type": "observation",
			"id": "s8",
			"t": 104,
			"kind": "exchange.adopted",
			"actor": "agent",
			"text": "仕様書 spec.md の内容で、発注書を作成します。"
		},
		{
			"type": "opportunity",
			"id": "s9",
			"t": 105,
			"trigger": "turn_end",
			"presence": "quiet",
			"foregroundBusy": false,
			"playerBusy": false,
			"expect": {
				"needed": true,
