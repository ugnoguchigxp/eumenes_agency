{
	"name": "eumenes-agency",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"verify": "bun scripts/verify.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"test": "bun test ./src ./test ./standalone ./eval",
		"agency": "bun standalone/cli.ts",
		"eval": "bun eval/main.ts",
		"pack": "bun scripts/pack.ts"
	},
	"dependencies": {
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "0.131.0",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.4.2"
}
