{
	"name": "eumenes-agency",
	"version": "0.1.7",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./agenda": "./src/agenda/index.ts"
	},
	"scripts": {
		"verify": "bun scripts/verify.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"test": "bun test ./src ./test ./standalone ./eval ./examples",
		"agency": "zsh -l scripts/api-entry.zsh standalone/agenda.ts",
		"agency:always-on": "zsh -l scripts/api-entry.zsh standalone/always-on.ts",
		"agency:legacy": "zsh -l scripts/api-entry.zsh standalone/cli.ts",
		"agenda": "zsh -l scripts/api-entry.zsh standalone/agenda.ts",
		"eval": "zsh -l scripts/api-entry.zsh eval/main.ts",
		"eval:initiative": "zsh -l scripts/api-entry.zsh eval/initiative/run.ts",
		"pack": "bun scripts/pack.ts",
		"eval:api": "zsh -l scripts/api-entry.zsh eval/api.ts",
		"usage:report": "bun scripts/usage-report.ts",
		"eval:performance": "bun eval/performance.ts",
		"eval:memory-performance": "bun eval/memory-performance.ts",
		"eval:cross-judge": "zsh -l scripts/api-entry.zsh eval/cross-judge.ts",
		"eval:synergy": "bun examples/virtual-eumenes/measure.ts",
		"eval:synergy:api": "zsh -l scripts/api-entry.zsh examples/virtual-eumenes/live.ts",
		"demo:mock-toolchain": "bun examples/virtual-eumenes/mock-demo.ts",
		"eval:conversation:api": "zsh -l scripts/api-entry.zsh examples/virtual-eumenes/native.ts",
		"eval:always-on": "bun eval/always-on/silence.ts",
		"eval:always-on:api": "zsh -l scripts/api-entry.zsh eval/always-on/live.ts",
		"eval:agenda:api": "zsh -l scripts/api-entry.zsh eval/agenda/live.ts"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "0.131.0",
		"@openai/codex-sdk": "0.160.0",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"eumenes-memory": "./examples/virtual-eumenes/vendor/eumenes-memory-0.0.4-30721f30aa19.tgz",
		"eumenes-memory-host": "./examples/virtual-eumenes/vendor/eumenes-memory-host-0.1.0-3b6091d1b1ea.tgz",
		"eumenes-steer": "./examples/virtual-eumenes/vendor/eumenes-steer-0.1.0-1ca04b8bee9b.tgz",
		"openai": "7.51.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.4.4"
}
