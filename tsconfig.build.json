{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"types": ["node"],
		"sourceMap": false,
		"declarationMap": false
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/test/**"]
}
